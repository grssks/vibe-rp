{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    { "source": "/settings", "destination": "/?openSettings=1", "permanent": false },
    { "source": "/directives", "destination": "/?openSettings=1&tab=settings-system-prompts-tab", "permanent": false },
    { "source": "/personas", "destination": "/?openSettings=1&tab=settings-personas-tab", "permanent": false }
  ],
  "rewrites": [
    { "source": "/chat", "destination": "/chat.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src *; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ]
}
